classDiagram
    class AuthController {
        +register(RegisterRequest) TokenResponse
        +login(LoginRequest) TokenResponse
    }
    class AuthService {
        -UserRepository users
        -PasswordEncoder passwordEncoder
        -JwtService jwtService
        +register(RegisterRequest) TokenResponse
        +login(LoginRequest) TokenResponse
    }
    class JwtService {
        -JwtEncoder encoder
        +issueToken(User) TokenResponse
    }
    class ExpenseController {
        +create(Jwt, ExpenseRequest) ExpenseResponse
        +list(Jwt, month, year) List~ExpenseResponse~
        +summarize(Jwt, month, year) MonthlySummaryResponse
        +findById(Jwt, id) ExpenseResponse
        +update(Jwt, id, ExpenseRequest) ExpenseResponse
        +delete(Jwt, id) void
    }
    class ExpenseService {
        -ExpenseRepository expenses
        -UserRepository users
        +create(ownerId, ExpenseRequest) ExpenseResponse
        +list(ownerId, month, year) List~ExpenseResponse~
        +summarize(ownerId, month, year) MonthlySummaryResponse
        +update(ownerId, id, ExpenseRequest) ExpenseResponse
        +delete(ownerId, id) void
    }
    class ExpenseRepository {
        <<interface>>
        +findAllByOwnerId(ownerId) List~Expense~
        +findByIdAndOwnerId(id, ownerId) Optional~Expense~
        +sumAmountByOwnerAndDateRange(ownerId, startDate, endDate) BigDecimal
    }
    class UserRepository {
        <<interface>>
        +findByEmail(email) Optional~User~
        +existsByEmail(email) boolean
    }
    class User {
        <<Entity>>
        -Long id
        -String name
        -String email
        -String passwordHash
    }
    class Expense {
        <<Entity>>
        -Long id
        -String description
        -BigDecimal amount
        -LocalDate date
        -Category category
        -User owner
    }
    class Category {
        <<enumeration>>
        FOOD
        TRANSPORT
        HOUSING
        LEISURE
        HEALTH
        OTHER
    }
    AuthController --> AuthService
    AuthService --> UserRepository
    AuthService --> JwtService
    ExpenseController --> ExpenseService
    ExpenseController ..> ExpenseRequest : validates
    ExpenseController ..> ExpenseResponse : returns
    ExpenseService --> ExpenseRepository
    ExpenseService --> UserRepository
    UserRepository ..> User : persists
    ExpenseRepository ..> Expense : persists
    User "1" -- "*" Expense : owns
    Expense --> Category
