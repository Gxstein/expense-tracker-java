classDiagram
    class Program {
        +main(String[] args) void
        -addExpense() void
        -listByMonth() void
        -updateExpense() void
        -deleteExpense() void
    }
    class ExpenseService {
        -ExpenseDAO dao
        +register(Expense expense) Expense
        +listAll() List~Expense~
        +listByMonth(int month, int year) List~Expense~
        +calculateTotal() BigDecimal
        +findById(Long id) Expense
        +update(Expense expense) boolean
        +delete(Long id) boolean
    }
    class ExpenseDAO {
        <<interface>>
        +save(Expense expense) Expense
        +findById(Long id) Optional~Expense~
        +findAll() List~Expense~
        +findByMonth(int month, int year) List~Expense~
        +calculateTotal() BigDecimal
        +update(Expense expense) boolean
        +delete(Long id) boolean
    }
    class ExpenseDAOJdbc {
        -DatabaseConnection database
        +save(Expense expense) Expense
        +findById(Long id) Optional~Expense~
        +findAll() List~Expense~
        +findByMonth(int month, int year) List~Expense~
        +calculateTotal() BigDecimal
        +update(Expense expense) boolean
        +delete(Long id) boolean
    }
    class DatabaseConnection {
        -String url
        -String user
        -String password
        +getConnection() Connection
    }
    class Expense {
        -Long id
        -String description
        -BigDecimal amount
        -LocalDate date
        -Category category
    }
    class Category {
        <<enumeration>>
        FOOD
        TRANSPORT
        HOUSING
        LEISURE
        HEALTH
        OTHER
    }
    Program --> ExpenseService : uses
    ExpenseService --> ExpenseDAO : uses
    ExpenseDAOJdbc ..|> ExpenseDAO : implements
    ExpenseDAOJdbc --> DatabaseConnection : opens connections
    ExpenseDAOJdbc ..> Expense : maps rows
    Expense --> Category : has
